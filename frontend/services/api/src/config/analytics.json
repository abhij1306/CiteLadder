{
  "max_window_days": 480,
  "preset_range_days": {
    "30d": 30,
    "90d": 90,
    "1y": 365
  },
  "worker_settings": {
    "lease_ttl_seconds": {
      "env": ["ANALYTICS_LEASE_TTL_SECONDS"],
      "type": "float",
      "default": 120.0,
      "exclusive_minimum": 0
    },
    "heartbeat_interval_seconds": {
      "env": ["ANALYTICS_HEARTBEAT_INTERVAL_SECONDS"],
      "type": "float",
      "default": 30.0,
      "exclusive_minimum": 0
    },
    "poll_interval_seconds": {
      "env": ["ANALYTICS_POLL_INTERVAL_SECONDS"],
      "type": "float",
      "default": 1.0,
      "exclusive_minimum": 0
    },
    "retry_delay_seconds": {
      "env": ["ANALYTICS_RETRY_DELAY_SECONDS"],
      "type": "float",
      "default": 30.0,
      "minimum": 0
    },
    "lease_reclaim_batch_size": {
      "env": ["ANALYTICS_LEASE_RECLAIM_BATCH_SIZE"],
      "type": "int",
      "default": 100,
      "exclusive_minimum": 0
    },
    "drain_budget_seconds": {
      "env": ["ANALYTICS_DRAIN_BUDGET_SECONDS"],
      "type": "float",
      "default": 300.0,
      "exclusive_minimum": 0
    },
    "task_max_attempts": {
      "env": ["ANALYTICS_TASK_MAX_ATTEMPTS"],
      "type": "int",
      "default": 3,
      "exclusive_minimum": 0
    }
  },
  "task_lease_ttl_seconds": {
    "crawl_log_pull": 300
  },
  "executor_not_wired_error": "executor_not_wired",
  "retry_error": "unknown",
