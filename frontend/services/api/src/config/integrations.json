{
  "transport": {
    "INTEGRATION_PROVIDER_GSC": "gsc",
    "INTEGRATION_PROVIDER_GA4": "ga4",
    "INTEGRATION_PROVIDER_BING": "bing",
    "INTEGRATION_PROVIDERS": ["bing", "ga4", "gsc"],
    "INTEGRATION_TRANSPORT_GOOGLE": "google_oauth",
    "INTEGRATION_TRANSPORT_MICROSOFT": "microsoft_oauth",
    "INTEGRATION_TRANSPORTS": ["google_oauth", "microsoft_oauth"],
    "INTEGRATION_PROVIDER_TRANSPORT": {
      "gsc": "google_oauth",
      "ga4": "google_oauth",
      "bing": "microsoft_oauth"
    },
    "INTEGRATION_OAUTH_REFRESHABLE": {
      "google_oauth": true,
      "microsoft_oauth": true
    },
    "INTEGRATION_OAUTH_AUTHORIZE_URLS": {
      "google_oauth": "https://accounts.google.com/o/oauth2/v2/auth",
      "microsoft_oauth": "https://www.bing.com/webmasters/oauth/authorize"
    },
    "INTEGRATION_OAUTH_TOKEN_URLS": {
      "google_oauth": "https://oauth2.googleapis.com/token",
      "microsoft_oauth": "https://www.bing.com/webmasters/oauth/token"
    },
    "INTEGRATION_OAUTH_REVOKE_URLS": {
      "google_oauth": "https://oauth2.googleapis.com/revoke",
      "microsoft_oauth": ""
    },
    "INTEGRATION_OAUTH_SCOPES": {
      "google_oauth": [
        "https://www.googleapis.com/auth/webmasters.readonly",
        "https://www.googleapis.com/auth/analytics.readonly"
      ],
      "microsoft_oauth": ["webmaster.read"]
    },
    "INTEGRATION_OAUTH_CALLBACK_PATH": "/api/v1/integrations/oauth/{provider}/callback",
    "INTEGRATION_OAUTH_LANDING_PATH": "/settings?tab=integrations",
    "INTEGRATION_OAUTH_RETURN_PATHS": ["/performance", "/demand", "/ai-traffic", "/settings"],
    "INTEGRATION_OAUTH_TRANSACTION_COOKIE": "citeladder_integration_oauth",
    "INTEGRATION_OAUTH_TRANSACTION_COOKIE_PATH": "/api/v1/integrations/oauth",
    "GSC_API_BASE_URL": "https://www.googleapis.com",
    "GSC_SEARCH_ANALYTICS_PATH": "/webmasters/v3/sites/{property_ref}/searchAnalytics/query",
    "GSC_SITES_PATH": "/webmasters/v3/sites",
    "GSC_PERMISSION_UNVERIFIED": "siteUnverifiedUser",
    "GSC_DOMAIN_PROPERTY_PREFIX": "sc-domain:",
    "GA4_API_BASE_URL": "https://analyticsdata.googleapis.com",
    "GA4_RUN_REPORT_PATH": "/v1beta/properties/{property_ref}:runReport",
    "GA4_ADMIN_API_BASE_URL": "https://analyticsadmin.googleapis.com",
    "GA4_ACCOUNT_SUMMARIES_PATH": "/v1beta/accountSummaries",
    "GA4_ACCOUNT_SUMMARIES_PAGE_SIZE": 200,
    "GA4_ACCOUNT_SUMMARIES_MAX_PAGES": 25,
    "GA4_PROPERTY_RESOURCE_PREFIX": "properties/",
    "BING_API_BASE_URL": "https://www.bing.com",
    "BING_API_JSON_ROOT": "/webmaster/api.svc/json/",
    "BING_SITES_PROBE_METHOD": "GetUserSites",
    "INTEGRATION_APPROVED_ENDPOINT_HOSTS": [
      "accounts.google.com",
      "analyticsadmin.googleapis.com",
      "analyticsdata.googleapis.com",
      "oauth2.googleapis.com",
      "www.bing.com",
      "www.googleapis.com"
    ]
  },
  "settings": {
    "sync_on_demand_active_limit": {
      "env": ["INTEGRATION_SYNC_ON_DEMAND_ACTIVE_LIMIT"],
