  "settings": {
    "openai_responses_url": {
      "env": ["PROVIDER_OPENAI_RESPONSES_URL"],
      "type": "str",
      "default": "https://api.openai.com/v1/responses"
    },
    "google_interactions_url": {
      "env": ["PROVIDER_GOOGLE_INTERACTIONS_URL"],
      "type": "str",
      "default": "https://generativelanguage.googleapis.com/v1beta/interactions"
    },
    "anthropic_messages_url": {
      "env": ["PROVIDER_ANTHROPIC_MESSAGES_URL"],
      "type": "str",
      "default": "https://api.anthropic.com/v1/messages"
    },
    "anthropic_version": {
      "env": ["PROVIDER_ANTHROPIC_VERSION"],
      "type": "str",
      "default": "2023-06-01"
    },
    "test_timeout_seconds": {
      "env": ["PROVIDER_TEST_TIMEOUT_SECONDS"],
      "type": "float",
      "default": 20.0
    },
    "test_max_output_tokens": {
      "env": ["PROVIDER_TEST_MAX_OUTPUT_TOKENS"],
      "type": "int",
      "default": 32
    },
    "anthropic_max_uses": {
      "env": ["PROVIDER_ANTHROPIC_MAX_USES"],
      "type": "int",
      "default": 5
    },
    "openai_max_tool_calls": {
      "env": ["PROVIDER_OPENAI_MAX_TOOL_CALLS"],
      "type": "int",
      "default": 1,
      "minimum": 0
    },
    "byok_key_grace_days": {
      "env": ["PROVIDER_BYOK_KEY_GRACE_DAYS"],
      "type": "int",
      "default": 7
    },
    "max_response_bytes": {
      "env": ["PROVIDER_MAX_RESPONSE_BYTES"],
      "type": "int",
      "default": 8388608,
      "exclusive_minimum": 0
    }
  },
  "probe_prompt": "Reply with the single word: ok.",
  "probe_max_request_bytes": 256000,
  "probe_max_response_bytes": 512000,
  "probe_success_detail": "Connection succeeded",
  "dataforseo": {
    "base_url": {
      "env": ["DATAFORSEO_BASE_URL"],
      "type": "str",
      "default": "https://api.dataforseo.com"
    },
    "test_timeout_seconds": {
      "env": ["DATAFORSEO_TEST_TIMEOUT_SECONDS"],
