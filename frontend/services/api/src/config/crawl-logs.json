{
  "ingestion_enabled": true,
  "default_reporting_timezone": "UTC",
  "default_range": "30d",
  "parser_version": "1",
  "formula_version": "1",
  "formats": ["ndjson", "json_array", "combined"],
  "presets": {
    "custom_ndjson": {
      "collection_point": "application",
      "sampling": { "kind": "none" },
      "timestamp": "timestamp",
      "host": "host",
      "path": "path",
      "method": "method",
      "status": "status",
      "user_agent": "user_agent",
      "client_ip": "client_ip",
      "request_id": "request_id",
      "timestamp_unit": "iso"
    },
    "cloudflare_logpush_http_requests": {
      "collection_point": "cdn_edge",
      "sampling": { "kind": "none" },
      "timestamp": "EdgeStartTimestamp",
      "host": "ClientRequestHost",
      "path": "ClientRequestPath",
      "method": "ClientRequestMethod",
      "status": "EdgeResponseStatus",
      "user_agent": "ClientRequestUserAgent",
      "client_ip": "ClientIP",
      "request_id": "RayID",
      "timestamp_unit": "iso"
    },
    "cloudflare_worker_template": {
      "collection_point": "cdn_edge",
      "sampling": {
        "kind": "filtered",
        "description": "Recognized automated requests only; best-effort delivery"
      },
      "timestamp": "timestamp",
      "host": "host",
      "path": "path",
      "method": "method",
      "status": "status",
      "user_agent": "user_agent",
      "client_ip": "client_ip",
      "request_id": "request_id",
      "timestamp_unit": "iso"
    },
    "cloudfront_v2_json": {
      "collection_point": "cdn_edge",
      "sampling": { "kind": "none" },
      "timestamp": "timestamp(ms)",
      "host": "x-host-header",
      "path": "cs-uri-stem",
      "method": "cs-method",
      "status": "sc-status",
      "user_agent": "cs(User-Agent)",
      "client_ip": "c-ip",
      "request_id": "x-edge-request-id",
      "timestamp_unit": "milliseconds",
      "timestamp_fallback": { "date": "date", "time": "time" },
      "missing_tokens": ["-"],
      "user_agent_decode": "url"
    },
    "gcp_log_entry": {
      "collection_point": "cdn_edge",
      "sampling": { "kind": "none" },
      "timestamp": "timestamp",
      "host": "host",
      "path": "path",
      "method": "method",
      "status": "status",
      "user_agent": "user_agent",
      "client_ip": "client_ip",
      "request_id": "request_id",
      "timestamp_unit": "iso"
    }
  },
  "gcp_pull": {
    "pull_interval_seconds": 300,
    "pull_max_iterations": 10,
    "pull_max_messages": 1000,
    "max_pull_gap_minutes": 30,
    "pull_settle_minutes": 15,
    "verification_interval_hours": 24,
    "min_ack_deadline_seconds": 60,
    "request_timeout_seconds": 10,
    "pull_wait_seconds": 20,
    "token_lifetime_seconds": 900,
    "token_refresh_margin_seconds": 60,
    "source_label": "citeladder-source"
  },
  "max_batch_bytes": 5242880,
  "max_lines_per_batch": 5000,
  "upload_sample_lines": 50,
  "insert_rows_per_statement": 500,
  "max_line_bytes": 16384,
  "max_sources_per_project": 20,
  "batches_per_source_per_hour": 600,
  "accepted_lines_per_project_per_day": 1000000,
  "received_bytes_per_project_per_day": 2147483648,
  "stalled_after_hours": 24,
  "max_clock_skew_hours": 1,
  "max_backdate_days": 80,
  "secret_path_patterns": [
    "(?<=/(?:reset|reset-password|magic-link|session|sessions)/)[^/]+",
    "(?:token|signature|sessionid|session_id)=[^/;]+"
  ],
  "folder_depth": 2,
  "retention_days": 90,
  "rollup_freeze_margin_days": 7,
  "refresh_delay_seconds": 120,
  "max_delivery_gap_minutes": 5,
  "buffered_delivery_grace_minutes": 5,
  "ip_range_refresh_hours": 24,
  "ip_range_max_age_hours": 72,
  "ip_range_contemporaneous_hours": 24,
  "default_verification_filter": ["verified", "unverifiable"],
  "upload_abandon_hours": 24,
  "sweep_batch_size": 500,
  "max_source_batch_ids": 1000,
  "default_page_size": 10,
  "max_page_size": 100,
  "ip_range_max_bytes": 1048576,
  "ip_range_timeout_seconds": 15,
  "ip_range_max_redirects": 3,
  "task_max_attempts": 3,
  "max_export_rows": 100000,
  "worker_timeout_ms": 5000,
  "worker_flush_seconds": 60,
  "worker_batch_lines": 300
}
