      "credential_unavailable_for_retrieval",
      "poll_ceiling_exceeded",
      "submission_unreconciled"
    ]
  },
  "settings": {
    "request_timeout_seconds": {
      "env": ["DATAFORSEO_REQUEST_TIMEOUT_SECONDS"],
      "type": "float",
      "default": 60.0,
      "exclusive_minimum": 0
    },
    "recovery_deadline_hours": {
      "env": ["DATAFORSEO_RECOVERY_DEADLINE_HOURS"],
      "type": "float",
      "default": 72.0,
      "exclusive_minimum": 0,
      "exclusive_maximum": 672
    },
    "max_response_bytes": {
      "env": ["DATAFORSEO_MAX_RESPONSE_BYTES"],
      "type": "int",
      "default": 8388608,
      "exclusive_minimum": 0
    }
  },
  "constants": {
    "dataforseo_base_url": "https://api.dataforseo.com",
    "path_user_data": "/v3/appendix/user_data",
