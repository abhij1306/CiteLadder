    "tag_max_chars": 255,
    "keyword_max_chars": 700,
    "default_depth": 10,
    "load_async_ai_overview": true,
    "observed_standard_task_cost_microusd": 1200,
    "async_ai_overview_surcharge_microusd": 600,
    "device_desktop": "desktop",
    "device_mobile": "mobile",
    "supported_devices": ["desktop", "mobile"],
    "os_for_device": {
      "desktop": "windows",
      "mobile": "android"
    },
    "default_device": "desktop",
    "default_language_code": "en",
    "locations_paths": {
      "google_ai_overview": {
        "locations": "/v3/serp/google/locations",
