{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite-plus/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "apps/app/**/*.ts",
    "apps/app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/mcp-app/**/*.tsx",
    "packages/mcp-app/vite.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
