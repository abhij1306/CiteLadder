{
  "name": "citeladder-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "dev": "vp dev -c apps/app/vite.config.ts",
    "build": "vp build -c apps/app/vite.config.ts",
    "preview": "vp preview -c apps/app/vite.config.ts",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check:complexity": "node scripts/check-frontend-complexity.mjs",
    "check:duplicates": "node scripts/check-jscpd.mjs",
    "report:duplicates:tests": "node scripts/check-jscpd.mjs --tests",
    "check:policy": "node scripts/check-design-system.mjs && node scripts/check-frontend-architecture.mjs",
    "check:contract": "pnpm --filter @citeladder/api check:routes",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dead-code": "knip"
  },
  "dependencies": {
    "@citeladder/contracts": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "jscpd": "5.4.1",
    "jsdom": "^30.1.2",
    "knip": "6.41.0",
    "msw": "^2.15.0",
    "oxc-parser": "^0.154.0",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "samsung >= 23",
    "not dead"
  ]
}
