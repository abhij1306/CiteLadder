{
  "name": "citeladder-frontend",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev -c apps/app/vite.config.ts",
    "build": "vp build -c apps/app/vite.config.ts",
    "preview": "vp preview -c apps/app/vite.config.ts",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:api": "pnpm --filter @citeladder/api test:local",
    "check:complexity": "node scripts/check-complexity.mjs --policy frontend",
    "check:complexity:api": "node scripts/check-complexity.mjs --policy api",
    "check:duplicates": "node scripts/check-jscpd.mjs --scope frontend",
    "check:duplicates:api": "node scripts/check-jscpd.mjs --scope api",
    "report:duplicates:tests": "node scripts/check-jscpd.mjs --tests",
    "check:policy": "node scripts/check-design-system.mjs && node scripts/check-frontend-architecture.mjs",
    "check:compat": "node scripts/check-browser-compat.mjs",
    "check:contract": "pnpm --filter @citeladder/api check:routes",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dead-code": "knip"
  },
  "dependencies": {
    "@citeladder/contracts": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "robots-parser": "3.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.1.9",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "browserslist": "4.29.5",
    "jscpd": "5.4.3",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "msw": "^3.0.4",
    "oxc-parser": "^0.158.0",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 128",
    "safari >= 17.4",
    "ios_saf >= 17.4",
    "samsung >= 25",
    "not dead"
  ]
}
