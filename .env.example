# CiteLadder settings. Everything here is optional: copy to .env and fill in
# only what you need. `docker compose up -d` and `pnpm start` both read .env.
#
# Instance secrets (ENCRYPTION_KEY, API_KEY_PEPPER, REFERRAL_HASH_SALT) are
# generated on first start; set them here only to manage them yourself.

# --- Where CiteLadder is reached --------------------------------------------
# The URL you open CiteLadder at. Used for OAuth redirects and the MCP/crawl-log
# URLs shown in the app. Docker: also change CITELADDER_PORT if you change the port.
# PUBLIC_APP_ORIGIN=http://localhost:8100
# CITELADDER_PORT=8100
# The API answers only to localhost and the host of PUBLIC_APP_ORIGIN
# (protection against DNS rebinding, since there is no login). Add any other
# host names you reach it by, comma-separated, e.g. behind a reverse proxy:
# ALLOWED_HOSTS=citeladder.internal,10.0.0.5

# --- Database (Docker Compose) -----------------------------------------------
# The bundled PostgreSQL is only reachable inside the Compose network.
# POSTGRES_DB=citeladder
# POSTGRES_USER=citeladder
# POSTGRES_PASSWORD=citeladder
# Without Docker, point at your own PostgreSQL 16:
# DATABASE_URL=postgresql://user:password@localhost:5432/citeladder

# --- LLM for the Agent, brand research and prompt generation -----------------
# The base URL picks the API. Anthropic uses its Messages API; anything else is
# called as OpenAI-compatible chat completions. The Agent (tool calling)
# supports Anthropic and OpenAI; research and generation work with any of:
#   Anthropic  https://api.anthropic.com
#   OpenAI     https://api.openai.com/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral    https://api.mistral.ai/v1
#   Ollama     http://host.docker.internal:11434/v1  (any non-empty API key;
#              plain HTTP is accepted only for local/private-network hosts)
DEFAULT_AGENT_API_KEY=
DEFAULT_AGENT_BASE_URL=https://api.anthropic.com
DEFAULT_AGENT_MODEL=claude-sonnet-5-5

# Answer-engine keys (OpenAI, Anthropic, Google) and DataForSEO credentials for
# AI Visibility audits are entered in the app under Settings -> Providers.

# --- MCP ---------------------------------------------------------------------
# Set a long random string to enable /mcp; clients send it as a bearer token.
MCP_TOKEN=

# --- Search Console, GA4 and Bing Webmaster sync -----------------------------
# Your own OAuth clients; add the redirect URI shown in Settings -> Integrations.
INTEGRATION_GOOGLE_CLIENT_ID=
INTEGRATION_GOOGLE_CLIENT_SECRET=
INTEGRATION_MICROSOFT_CLIENT_ID=
INTEGRATION_MICROSOFT_CLIENT_SECRET=

# --- Optional research providers ---------------------------------------------
# Web search for Commerce competitor discovery.
TAVILY_API_KEY=
# External research during brand discovery.
KEENABLE_API_KEY=
# Quality judge for generated prompt candidates.
JEV_API_KEY=

# --- AI crawler logs (Google Cloud) ------------------------------------------
# Service account the server impersonates to pull your Cloud Logging Pub/Sub
# subscriptions. Works only when CiteLadder itself runs on Google Cloud (it uses
# the metadata-server identity). Empty hides the Google Cloud connector; the
# other log connectors and uploads work anywhere.
CRAWL_LOG_READER_EMAIL=

# --- Site Health crawler -----------------------------------------------------
# Polite defaults for crawling a single site behind a CDN.
# SITE_HEALTH_GLOBAL_CONCURRENCY=4
# SITE_HEALTH_PER_HOST_CONCURRENCY=2
# SITE_HEALTH_PER_HOST_DELAY_SECONDS=1.0
# SITE_HEALTH_MONITORED_URL_LIMIT=500

# --- Browser app (build time) ------------------------------------------------
# logo.dev publishable key for brand avatars; unset falls back to initials.
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE=
